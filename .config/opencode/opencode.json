{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "plan",
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp/opencode/**": "allow"
    },
    "bash": {
      "*": "ask",
      "git *": "allow",
      "npm *": "allow",
      "grep *": "allow",
      "rm *": "deny"
    }
  },
  "shell": "/bin/zsh",
  "plugin": ["@mohak34/opencode-notifier@latest"]
}
