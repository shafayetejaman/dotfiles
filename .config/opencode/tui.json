{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "system",
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "stacked",
  "mouse": true,
  "keybinds": {
    "input_delete_word_forward": "alt+delete",
    "input_delete_word_backward": "ctrl+w,ctrl+backspace,ctrl+delete",
    "input_submit": "return,ctrl+return",
    "input_newline": "shift+return"
  },
  "plugin": [
    "@leohenon/opencode-vim-plugin"
  ]
}
