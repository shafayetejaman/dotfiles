#!/bin/bash

# Override of ~/.local/share/omarchy/bin/omarchy-hyprland-window-transparency-toggle
# Fixes legacy `hyprctl dispatch setprop` which fails under Hyprland 0.55+ Lua config.
# Delete this file once upstream omarchy ships the fix.

# omarchy:summary=Toggles transparency for the currently focused window.

addr=$(hyprctl activewindow -j | jq -r '.address')
hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"opaque\", value = \"toggle\", window = \"address:$addr\" })"
