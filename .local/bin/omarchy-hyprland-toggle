#!/bin/bash

# Override of ~/.local/share/omarchy/bin/omarchy-hyprland-toggle
# Shows toggle feedback via SwayOSD instead of notify-send.
# Delete this file once upstream omarchy ships the fix/preference.

# omarchy:summary=Toggle permanent Hyprland flags by copying them into a directory that's sourced entirely.
# omarchy:args=[--enabled-notification <text>] [--disabled-notification <text>] <flag-name>

ENABLED_NOTIFICATION=""
DISABLED_NOTIFICATION=""

while [[ $# -gt 1 ]]; do
  case $1 in
    --enabled-notification) ENABLED_NOTIFICATION="$2"; shift 2 ;;
    --disabled-notification) DISABLED_NOTIFICATION="$2"; shift 2 ;;
    *) break ;;
  esac
done

FLAG_NAME="$1"
FLAG="$HOME/.local/state/omarchy/toggles/hypr/$FLAG_NAME.conf"
FLAG_SOURCE="$OMARCHY_PATH/default/hypr/toggles/$FLAG_NAME.conf"

# Map toggle flags to an OSD icon
case $FLAG_NAME in
  single-window-aspect-ratio) ICON="view-restore-symbolic" ;;
  window-no-gaps) ICON="view-grid-symbolic" ;;
  *monitor*) ICON="computer-symbolic" ;;
  *) ICON="" ;;
esac

notify() {
  [[ -n $1 ]] || return 0
  # Strip leading Nerd Font glyphs; they don't render inside the OSD
  local message
  message=$(printf '%s' "$1" | sed 's/^[^[:alnum:]]*//')
  if [[ -n $ICON ]]; then
    omarchy-swayosd-client --custom-icon "$ICON" --custom-message "$message"
  else
    omarchy-swayosd-client --custom-message "$message"
  fi
}

if [[ -f $FLAG ]]; then
  rm $FLAG
  notify "$DISABLED_NOTIFICATION"
elif [[ -f $FLAG_SOURCE ]]; then
  cp $FLAG_SOURCE $FLAG
  notify "$ENABLED_NOTIFICATION"
else
  echo "Flag not found: $FLAG_NAME"
  exit 1
fi

hyprctl reload
