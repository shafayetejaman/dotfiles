#!/bin/bash

# Receives clipboard entry on stdin (piped by elephant's clipboard provider),
# copies it, then simulates a paste keystroke into the focused window.
# Terminals need Ctrl+Shift+V; regular apps use Ctrl+V.

wl-copy
sleep 0.15

CLASS=$(hyprctl -j activewindow 2>/dev/null | jq -r '.class // empty' | tr '[:upper:]' '[:lower:]')

if [[ "$CLASS" =~ (ghostty|kitty|foot|alacritty|wezterm|terminal|konsole) ]]; then
  wtype -M ctrl -M shift v -m shift -m ctrl
else
  wtype -M ctrl v -m ctrl
fi
