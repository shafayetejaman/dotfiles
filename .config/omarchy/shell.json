{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "io.github.pjgeutjens.clockwork",
          "pomodoroCycles": 10,
          "pomodoroWorkMinutes": 30
        },
        {
          "id": "omarchy.clock",
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "shavanced.notification-center"
        }
      ],
      "left": [
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "shafayet.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "tanzil.sysmon",
          "intervalMs": 5000
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "shafayet.audio"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "b.omashot",
      "captureMode": "selection",
      "outputMode": "clipboard",
      "includeCursor": false
    },
    {
      "id": "shafayet.clipboard"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.clipboard",
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "shafayet.clipboard",
    "shafayet.menu"
  ]
}
