#!/usr/bin/env bash
# Give Haruna white Breeze Dark control icons without changing the desktop icon theme.
export XDG_DATA_DIRS="${HOME}/.local/share/haruna-icons${XDG_DATA_DIRS:+:${XDG_DATA_DIRS}}"
# Match the scaling Haruna already gets when opened from Yazi.
export QT_SCALE_FACTOR=1.24
export QT_AUTO_SCREEN_SCALE_FACTOR=1
exec /usr/bin/haruna "$@"
