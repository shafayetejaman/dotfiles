{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "plan",
  "permission": {
    "external_directory": {
      "*": "ask",
      "/tmp/opencode/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.ssh/**": "deny"
    },
    "bash": {
      "*": "allow",
      "mv *": "ask",
      "tr *": "ask",
      "rm *": "ask",
      "sed -i": "ask",
      "gh auth token": "deny"
    },
    "read": {
      "~/.ssh/**": "deny",
      ".ssh/**": "deny"
    },
    "edit": {
      "~/.ssh/**": "deny",
      ".ssh/**": "deny"
    },
    "glob": {
      "~/.ssh/**": "deny",
      ".ssh/**": "deny"
    },
    "grep": {
      "~/.ssh/**": "deny",
      ".ssh/**": "deny"
    }
  },
  "shell": "/bin/zsh",
  "plugin": ["@mohak34/opencode-notifier@latest"]
}
