#!/bin/bash

# Override of ~/.local/share/omarchy/bin/omarchy-toggle-notification-silencing
# Shows toggle feedback via SwayOSD instead of notify-send.
# Delete this file once upstream omarchy ships the fix/preference.

# omarchy:summary=Toggle notification do-not-disturb mode

makoctl mode -t do-not-disturb

if makoctl mode | grep -q 'do-not-disturb'; then
  omarchy-swayosd-client --custom-icon notifications-disabled-symbolic --custom-message "Silenced notifications"
else
  omarchy-swayosd-client --custom-icon preferences-system-notifications-symbolic --custom-message "Enabled notifications"
fi

pkill -RTMIN+10 waybar
