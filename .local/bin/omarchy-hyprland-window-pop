#!/bin/bash

# Override of ~/.local/share/omarchy/bin/omarchy-hyprland-window-pop
# Fixes legacy `hyprctl dispatch`/`--batch "dispatch ..."` syntax which fails under Hyprland 0.55+ Lua config.
# Delete this file once upstream omarchy ships the fix.

# omarchy:summary=Toggle to pop-out a tile to stay fixed on a display basis.
# omarchy:args=[width height x y]

width=${1:-1300}
height=${2:-900}
x=${3:-}
y=${4:-}

active=$(hyprctl activewindow -j)
pinned=$(echo "$active" | jq ".pinned")
addr=$(echo "$active" | jq -r ".address")

if [[ $pinned == "true" ]]; then
  hyprctl -q dispatch "hl.dsp.window.pin({ window = \"address:$addr\" })"
  hyprctl -q dispatch "hl.dsp.window.float({ action = \"toggle\", window = \"address:$addr\" })"
  hyprctl -q dispatch "hl.dsp.window.tag({ tag = \"-pop\", window = \"address:$addr\" })"
elif [[ -n $addr ]]; then
  hyprctl dispatch "hl.dsp.window.float({ action = \"toggle\", window = \"address:$addr\" })"
  hyprctl dispatch "hl.dsp.window.resize({ x = $width, y = $height, relative = false, window = \"address:$addr\" })"

  if [[ -n $x && -n $y ]]; then
    hyprctl dispatch "hl.dsp.window.move({ x = $x, y = $y, window = \"address:$addr\" })"
  else
    hyprctl dispatch "hl.dsp.window.center({ window = \"address:$addr\" })"
  fi

  hyprctl -q dispatch "hl.dsp.window.pin({ window = \"address:$addr\" })"
  hyprctl -q dispatch "hl.dsp.window.alter_zorder({ mode = \"top\", window = \"address:$addr\" })"
  hyprctl -q dispatch "hl.dsp.window.tag({ tag = \"+pop\", window = \"address:$addr\" })"
fi
