{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "io.github.pjgeutjens.clockwork",
          "pomodoroCycles": 10,
          "pomodoroWorkMinutes": 30
        },
        {
          "format": "dddd h:mm AP",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.system-update"
        },
        {
          "id": "shavanced.notification-center"
        }
      ],
      "left": [
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "shafayet.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "mt-shihab26.omaspeedmeter",
          "order": "cpu,mem,net,temp,gpu,procs",
          "labels": false,
          "interval": 10,
          "gap": 15,
          "gpuVendor": "none",
          "tempZone": "/sys/class/thermal/thermal_zone3/temp",
          "net": false,
          "gpu": false,
          "temp": true,
          "netIface": "enp2s0"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "shafayet.audio"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "cloneSourceRestores": [
    "shafayet.clipboard",
    "shafayet.menu"
  ],
  "disabledPlugins": [
    "omarchy.clipboard",
    "omarchy.menu"
  ],
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "captureMode": "selection",
      "id": "b.omashot",
      "includeCursor": false,
      "outputMode": "clipboard"
    },
    {
      "id": "shafayet.clipboard"
    },
    {
      "id": "shafayet.finder",
      "ignored_dirs": [
        "$HOME/.cache"
      ],
      "search_dirs": [
        "$HOME",
        "/mnt/HDD/Downloads/Video",
        "/mnt/HDD/Downloads/Documents"
      ]
    }
  ],
  "version": 1
}
