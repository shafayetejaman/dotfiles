(defcfg
  process-unmapped-keys yes
)

(defvar
  tap-time 190
  hold-time 200
)

(defsrc
  tab caps ' ;
)

(defalias
  tabcaps (tap-hold $tap-time $hold-time tab caps)
  escctrl (tap-hold $tap-time $hold-time esc lctl)
  ' (tap-hold $tap-time $hold-time ' rmet)
  ; (tap-hold $tap-time $hold-time ; rctl)
)

(deflayer base
  @tabcaps @escctrl @' @;
)

