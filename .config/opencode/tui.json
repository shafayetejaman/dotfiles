{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "system",
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "stacked",
  "mouse": true,
  "keybinds": {
    "input_delete_word_forward": "alt+delete",
    "input_delete_word_backward": "ctrl+w,ctrl+backspace,ctrl+delete",
    "input_submit": "return,ctrl+return",
    "input_newline": "shift+return",
    "messages_page_up": "shift+alt+k",
    "messages_page_down": "shift+alt+j",
    "messages_previous": "shift+alt+up",
    "messages_next": "shift+alt+down"
  },
  "plugin": [["@leohenon/opencode-vim-plugin", { "vim_enter_submit": true }]]
}
